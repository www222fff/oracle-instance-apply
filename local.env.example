# 复制为 local.env（已被 git 忽略），run.sh 启动时会 source 它。

# 和其他操作同一个 Chrome 的任务共用一把锁，避免同时操作。
OCI_APPLY_LOCK_FILE=/tmp/oracle-instance-apply.lock
OCI_APPLY_LAST_LOG=/tmp/oracle-instance-apply.last.log
# 等锁的最长秒数，应小于定时间隔，避免任务排队堆积。
OCI_APPLY_LOCK_WAIT=120

# 可选：指定配置文件路径（默认是仓库里的 config.json）。
# OCI_APPLY_CONFIG=/path/to/config.json

# 可选：chromeHelper 模块需要的环境变量，例如：
# export HERMES_CHROME_CDP_URL=http://127.0.0.1:9223
# export HERMES_WINDOWS_CHROME_PROFILE=my-cdp-profile
# export HERMES_CHROME_PROXY=socks5://127.0.0.1:1080
